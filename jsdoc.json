{
  "source": {
    "include": [
      "codecept/tests",
      "codecept/pages",
      "codecept/support"
    ],
    "includePattern": ".+\\.js$"
  },
  "plugins": [
    "scripts/docs/jsdoc_auto_module.js"
  ],
  "opts": {
    "destination": "docs/generated/html",
    "recurse": true,
    "template": "node_modules/docdash",
    "readme": "docs/project/jsdoc_home.md"
  },
  "docdash": {
    "search": true,
    "collapse": true,
    "sectionOrder": [
      "Modules",
      "Classes",
      "Namespaces",
      "Mixins",
      "Interfaces",
      "Events",
      "Externals",
      "Tutorials",
      "Global"
    ]
  }
}
