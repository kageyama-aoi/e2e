# shimamura テスト環境設定テンプレート
# このファイルをコピーして .env.shimamura.<プロファイル名> という名前で保存し、値を設定する。
# 例: cp .env.shimamura.template .env.shimamura.testgcp
# 使用時: npx codeceptjs run <test> --profile shimamura.testgcp

# ─────────────────────────────────────────────
# BASE_URL
#   テスト対象の shimamura サーバーの URL（末尾スラッシュなし）。
#   ログイン画面 / 各モジュールへの遷移の起点になる。
#   例: https://tcns.shimamura.co.jp/traininggcp
# ─────────────────────────────────────────────
BASE_URL=https://tcns.shimamura.co.jp/traininggcp

# ─────────────────────────────────────────────
# SHIMAMURA_USER
#   ログイン画面の「ユーザー名」フィールドに入力するログインID。
#
# SHIMAMURA_PASSWORD
#   ログイン画面の「パスワード」フィールドに入力するパスワード。
#   特殊文字を含む場合はダブルクォートで囲む（例: "#vanilla09"）。
# ─────────────────────────────────────────────
SHIMAMURA_USER=your_username
SHIMAMURA_PASSWORD=your_password

# ─────────────────────────────────────────────
# SHIMAMURA_TANTOUSYA
#   ログイン後に表示される「担当者番号」入力画面で使用する担当者番号（5桁ゼロ埋め）。
#   環境によってはこの画面が出ない場合もあるが、その場合はスキップされるため設定は必須。
#   例: 00033
# ─────────────────────────────────────────────
SHIMAMURA_TANTOUSYA=your_staff_number

# ─────────────────────────────────────────────
# HEADLESS
#   Playwright のブラウザをヘッドレスモードで起動するかどうか。
#   false : ブラウザウィンドウが表示される（デバッグ・目視確認向き）
#   true  : バックグラウンド実行（CI / 自動実行向き）
# ─────────────────────────────────────────────
HEADLESS=false

# ─────────────────────────────────────────────
# SCREENSHOT_ON_NAVIGATION
#   画面遷移（navigateTo...）のたびにスクリーンショットを撮影して Allure レポートに添付するか。
#   true  : 遷移ごとに撮影（レポートで画面の流れを追える）
#   false : 撮影しない（実行時間を短縮したい場合）
# ─────────────────────────────────────────────
SCREENSHOT_ON_NAVIGATION=true

# ─────────────────────────────────────────────
# CHECKBOX_DEBUG
#   チェックボックス操作（clickCheckboxByLabelOrName）の詳細ログを出力するか。
#   true  : どのセレクタで click したかをコンソールに出力（挙動調査向き）
#   false : ログなし（通常運用）
# ─────────────────────────────────────────────
CHECKBOX_DEBUG=false

# ─────────────────────────────────────────────
# FORM_FILL_FAST  （省略可）
#   テキストフィールドの入力方式を切り替える。
#   true  : I.executeScript で全フィールドを一括セット（高速）
#   false : I.fillField で1フィールドずつ入力（安全・デフォルト）
#   ※ shimamura.testgcp は true 推奨
# ─────────────────────────────────────────────
FORM_FILL_FAST=false

# ─────────────────────────────────────────────
# SHIMAMURA_NAV  （省略可）
#   一覧画面・登録フォームへの遷移方式を切り替える。
#   未設定（デフォルト）: directUrl で直接遷移（高速・安定）
#   sidebar             : モジュール TOP へ遷移後、サイドバーのリンクをクリックして遷移
#                         折りたたみメニュー（問合せ / 入出金）は自動で開く。
#
#   対応画面:
#     一覧系（IchiranPage）: 全画面対応
#     登録フォーム系（FlowPage）:
#       - 講師謝礼追加 (KoushiShareiFlowPage):
#           sidebar → 講師謝礼一覧へ遷移後、サイドバーの「講師謝礼追加」をクリック
#
#   ※ コース一覧（ShimaCourse）はモードに関わらず常に directUrl を使用する
#      （サイドバーリンクに top_menu=1 がなく検索状態がリセットされないため）。
# ─────────────────────────────────────────────
# SHIMAMURA_NAV=sidebar
