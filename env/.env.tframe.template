# =============================================================================
# tframe E2E テスト 環境設定テンプレート
#
# 使い方:
#   このファイルをコピーして .env.tframe.<環境名> という名前で保存する
#   例: .env.tframe.culture_beta / .env.tframe.juku_test
#
# 実行時にプロファイルとして指定する:
#   npx codeceptjs run <テストファイル> --profile tframe.<環境名>
# =============================================================================


# -----------------------------------------------------------------------------
# 接続先
# -----------------------------------------------------------------------------

# テスト対象の管理画面ベースURL（末尾スラッシュ必須）
# 例: https://newculture.e-school.jp/beta/
BASE_URL=https://your-tframe-url.example.com/


# -----------------------------------------------------------------------------
# 管理者アカウント（管理画面ログイン用）
# @admin タグのついたテストで使用する
# -----------------------------------------------------------------------------

ADMIN_USER=adminuser
ADMIN_PASSWORD=your_admin_password


# -----------------------------------------------------------------------------
# 講師アカウント（マイページ・講師ログイン用）
# ログイン形式は環境によって異なる（数字ID or メールアドレス）
# -----------------------------------------------------------------------------

TEST_USER_TEACHER=your_teacher_id_or_email
TEST_PASSWORD_TEACHER=your_teacher_password


# -----------------------------------------------------------------------------
# 生徒アカウント（マイページ・生徒ログイン用）
# -----------------------------------------------------------------------------

TEST_USER_STUDENT=your_student_id_or_email
TEST_PASSWORD_STUDENT=your_student_password


# -----------------------------------------------------------------------------
# マイページURL（講師・生徒それぞれ別ドメインになることが多い）
# LoginMyPageTeacher / LoginMyPageStudent Page Object で使用
# -----------------------------------------------------------------------------

LOGIN_MYPAGE_URL_TEACHER=https://mypaget-your-env.example.com/index.php
LOGIN_MYPAGE_URL_STUDENT=https://mypage-your-env.example.com/index.php


# -----------------------------------------------------------------------------
# 表示言語
# KoshiPage などのメニューテキスト判定に使用する
# ja → 日本語メニュー / en → 英語メニュー
# 省略した場合は ja 扱いになる
# -----------------------------------------------------------------------------

# TFRAME_LANGUAGE=ja


# -----------------------------------------------------------------------------
# ブラウザ表示モード
# true  → ヘッドレス（画面非表示・CI向け・高速）
# false → ブラウザ表示あり（ローカル確認・デバッグ向け）
# 推奨デフォルト: false（手元確認しやすい）
# -----------------------------------------------------------------------------

HEADLESS=false


# -----------------------------------------------------------------------------
# フォーム入力モード
# false → fillField で1フィールドずつ入力（安全・inputイベント発火あり）
#         バリデーションがリアルタイム動作するフォームに適している
# true  → executeScript で一括セット（高速・約30%短縮）
#         シンプルなサーバーサイドフォームに適している
#         ドロップダウン・AJAX連動フィールドは常に個別処理される
# 推奨デフォルト: false（安全優先）
# -----------------------------------------------------------------------------

FORM_FILL_FAST=false
