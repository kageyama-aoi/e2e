{
  "name": "e2e-tests",
  "version": "1.0.0",
  "description": "CodeceptJS E2E Tests",
  "scripts": {
    "gui":    "python run/run_gui.py",

    "test": "npx codeceptjs run",

    "--- SHIMAMURA TESTS ---": "echo '--- SHIMAMURA TESTS ---'",
    "pretest_s": "node scripts/check_pause.js",
    "test_s": "npx codeceptjs run ./tests/shimamura/**/*_test.js --profile shimamura.testgcp",

    "--- TFRAME TESTS ---": "echo '--- TFRAME TESTS ---'",
    "test_t": "npx codeceptjs run ./tests/tframe/**/*_test.js",
    
    "--- TASKREPORT TESTS ---": "echo '--- TASKREPORT TESTS ---'",
    "test_taskreport": "npx codeceptjs run ./tests/taskreport/*_test.js --profile taskreport",
    
    "--- ALLURE ---": "echo '--- ALLURE ---'",
    "allure:serve":   "npx allure serve allure-results",
    "allure:latest":  "node scripts/allure/serve_latest.js",
    "allure:report":  "npx allure generate allure-results --clean -o allure-report",
    "allure:open":    "npx allure open allure-report",
    "allure:clean":   "rimraf allure-results/default allure-results/tframe.* allure-results/shimamura.* allure-results/taskreport.*",
    "allure:archive": "python scripts/allure/archive_allure_results.py",

    "--- CLEANUP ---": "echo '--- CLEANUP ---'",
    "cleanup":         "python scripts/cleanup/cleanup_output_logs.py",
    "cleanup:dry":     "python scripts/cleanup/cleanup_output_logs.py --dry-run",
    "cleanup:output":  "python scripts/cleanup/cleanup_output_logs.py --target output",
    "cleanup:logs":    "python scripts/cleanup/cleanup_output_logs.py --target logs",

    "--- DOCUMENTATION ---": "echo '--- DOCUMENTATION ---'",
    "docs:jsdoc": "jsdoc -c jsdoc.json",
    "docs:update-readme-map": "python scripts/docs/tree_generator.py -u",
    "docs:tree:file": "python scripts/docs/tree_generator.py -o docs/tree.md",
    "docs:catalog": "python scripts/docs/gen_test_catalog.py",
    "docs:all": "npm run docs:update-readme-map && npm run docs:catalog"
  },
  "keywords": [
    "codeceptjs",
    "e2e"
  ],
  "dependencies": {
    "allure-codeceptjs": "^2.15.1",
    "codeceptjs": "^3.3.7",
    "playwright": "^1.30.0"
  },
  "devDependencies": {
    "@codeceptjs/configure": "^1.0.6",
    "docdash": "^2.0.2",
    "dotenv": "^17.2.3"
  }
}
