{
  "name": "e2e-tests",
  "version": "1.0.0",
  "description": "CodeceptJS E2E Tests",
  "scripts": {
    "postinstall": "node scripts/hooks/install_git_hooks.js",
    "gui": "python run/run_gui.py",
    "test": "npx codeceptjs run --grep @wip --invert",
    "test_wip": "npx codeceptjs run --grep @wip",
    "test:unit": "node --test \"codecept/tests/unit/*.test.js\"",
    "--- SHIMAMURA TESTS ---": "echo '--- SHIMAMURA TESTS ---'",
    "pretest_s": "node run/checks/check_pause.js",
    "test_s": "npx codeceptjs run ./codecept/tests/shimamura/**/*_test.js --profile shimamura.testgcp --grep @wip --invert",
    "--- TFRAME TESTS ---": "echo '--- TFRAME TESTS ---'",
    "test_t": "npx codeceptjs run ./codecept/tests/tframe/**/*_test.js --profile tframe.culture_beta --grep @wip --invert",
    "--- TASKREPORT TESTS ---": "echo '--- TASKREPORT TESTS ---'",
    "test_taskreport": "npx codeceptjs run ./codecept/tests/taskreport/*_test.js --profile taskreport --grep @wip --invert",
    "--- ALLURE ---": "echo '--- ALLURE ---'",
    "allure:serve": "npx allure serve output/allure-results",
    "allure:latest": "node run/allure/serve_latest.js",
    "allure:report": "npx allure generate output/allure-results --clean -o output/allure-report",
    "allure:open": "npx allure open output/allure-report",
    "allure:clean": "rimraf output/allure-results/default output/allure-results/tframe.* output/allure-results/shimamura.* output/allure-results/taskreport.*",
    "allure:archive": "python run/allure/archive_allure_results.py",
    "--- CLEANUP ---": "echo '--- CLEANUP ---'",
    "cleanup": "python run/cleanup/cleanup_output_logs.py",
    "cleanup:dry": "python run/cleanup/cleanup_output_logs.py --dry-run",
    "cleanup:output": "python run/cleanup/cleanup_output_logs.py --target output",
    "cleanup:logs": "python run/cleanup/cleanup_output_logs.py --target logs",
    "--- DOCUMENTATION ---": "echo '--- DOCUMENTATION ---'",
    "predocs:jsdoc": "node -e \"require('fs').rmSync('docs/generated/html',{recursive:true,force:true})\"",
    "docs:jsdoc": "jsdoc -c jsdoc.json",
    "postdocs:jsdoc": "node scripts/docs/jsdoc_widen_nav.js",
    "docs:update-readme-map": "python scripts/docs/tree_generator.py -u",
    "docs:tree:file": "python scripts/docs/tree_generator.py -o docs/tree.md",
    "docs:catalog": "python scripts/docs/gen_test_catalog.py",
    "docs:menu-coverage": "node scripts/docs/gen_tframe_menu_coverage.js",
    "docs:menu-coverage:shimamura": "node scripts/docs/gen_shimamura_menu_coverage.js",
    "docs:check-refs": "python scripts/docs/check_doc_refs.py --check",
    "docs:decision-tables": "node scripts/docs/gen_decision_tables.js",
    "docs:all": "npm run docs:update-readme-map && npm run docs:catalog && npm run docs:menu-coverage && npm run docs:menu-coverage:shimamura && npm run docs:decision-tables"
  },
  "keywords": [
    "codeceptjs",
    "e2e"
  ],
  "dependencies": {
    "allure-codeceptjs": "^2.15.1",
    "codeceptjs": "^3.3.7",
    "playwright": "^1.30.0"
  },
  "devDependencies": {
    "@codeceptjs/configure": "^1.0.6",
    "docdash": "^2.0.2",
    "dotenv": "^17.2.3",
    "jsdoc": "^4.0.5"
  }
}
